{
  "name": "sanity-plugin-jev-fields",
  "version": "0.1.1",
  "description": "Jev signals for Sanity Studio: AI-evaluated yes/no, score and choice answers attached to a field, from TypeSafe's Jev model through Vercel AI Gateway",
  "keywords": [
    "ai",
    "ai-gateway",
    "jev",
    "sanity",
    "sanity-plugin",
    "typesafe"
  ],
  "homepage": "https://github.com/frederikvonsperling/sanity-plugin-jev-fields#readme",
  "bugs": {
    "url": "https://github.com/frederikvonsperling/sanity-plugin-jev-fields/issues"
  },
  "license": "MIT",
  "author": "Frederik von Sperling (https://frederikvonsperling.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frederikvonsperling/sanity-plugin-jev-fields.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "changeset": "changeset",
    "format": "oxfmt",
    "lint": "oxlint",
    "prepublishOnly": "pnpm run build",
    "record-fixtures": "node scripts/record-fixtures.ts",
    "release": "pnpm build && node scripts/publish.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "version-packages": "changeset version",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@sanity/icons": "^5.2.3",
    "@sanity/ui": "^4.3.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@sanity/browserslist-config": "^1.0.5",
    "@sanity/pkg-utils": "^13.0.6",
    "@sanity/plugin-kit": "^10.0.11",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.18.0",
    "styled-components": "^6.5.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^19.2",
    "react-dom": "^19.2",
    "sanity": "^6",
    "styled-components": "^6.1"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "sanityPlugin": {
    "verifyPackage": {
      "srcIndex": false,
      "scripts": false
    }
  }
}
